"""
製程能力分析 (Ppk) 與常態性檢定
需要套件: numpy, scipy
安裝: pip install numpy scipy
"""

import numpy as np
from scipy import stats

# ------------------------------------------------------------------
# 1. 原始數據
# ------------------------------------------------------------------
data = [
    6.542, 6.532, 6.531, 6.535, 6.537, 6.540, 6.535, 6.531, 6.539, 6.530,
    6.537, 6.531, 6.530, 6.531, 6.540, 6.537, 6.533, 6.537, 6.532, 6.534,
    6.531, 6.523, 6.530, 6.531, 6.534, 6.532, 6.534, 6.530, 6.537, 6.533,
]
data = np.array(data)
n = len(data)

# ------------------------------------------------------------------
# 2. 規格上下限 (依實際製程需求修改)
# ------------------------------------------------------------------
USL = 6.55
LSL = 6.45

# ------------------------------------------------------------------
# 3. 基本統計量
# ------------------------------------------------------------------
mean = data.mean()
std = data.std(ddof=1)  # 樣本標準差 (n-1)

print(f"樣本數 n        = {n}")
print(f"平均值 x_bar    = {mean:.4f}")
print(f"標準差 s        = {std:.5f}")
print(f"最小值 / 最大值 = {data.min()} / {data.max()}")

# ------------------------------------------------------------------
# 4. Ppk 計算
# ------------------------------------------------------------------
Ppu = (USL - mean) / (3 * std)
Ppl = (mean - LSL) / (3 * std)
Ppk = min(Ppu, Ppl)

print(f"\nUSL = {USL}, LSL = {LSL}")
print(f"Ppu = {Ppu:.3f}")
print(f"Ppl = {Ppl:.3f}")
print(f"Ppk = {Ppk:.3f}")

# ------------------------------------------------------------------
# 5. 常態性檢定
# ------------------------------------------------------------------
sw_stat, sw_p = stats.shapiro(data)
ad_result = stats.anderson(data, dist="norm")

print(f"\nShapiro-Wilk: W = {sw_stat:.4f}, p = {sw_p:.4f}")
print(f"Anderson-Darling: 統計量 = {ad_result.statistic:.4f}")
print("臨界值 (顯著水準%):")
for cv, sig in zip(ad_result.critical_values, ad_result.significance_level):
    print(f"  {sig:>4.1f}% -> {cv:.4f}")

# ------------------------------------------------------------------
# 6. 常態機率圖 (Normal Probability Plot) 用的資料
# ------------------------------------------------------------------
sorted_data = np.sort(data)
plotting_positions = (np.arange(1, n + 1) - 0.5) / n
z_scores = stats.norm.ppf(plotting_positions)

print("\n排序值, z 值 (常態機率圖座標):")
for val, z in zip(sorted_data, z_scores):
    print(f"  {val:.3f}, {z:.3f}")

# ------------------------------------------------------------------
# 7. 繪圖 (直方圖 + 常態曲線 + 常態機率圖)
# ------------------------------------------------------------------
import matplotlib.pyplot as plt

fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# 直方圖 + 常態分配曲線 + 規格線
axes[0].hist(data, bins=7, color="#2a78d6", edgecolor="white", alpha=0.85)
x_curve = np.linspace(LSL - 0.01, USL + 0.01, 300)
bin_width = (data.max() - data.min()) / 7
pdf = stats.norm.pdf(x_curve, mean, std) * n * bin_width
axes[0].plot(x_curve, pdf, color="#9085e9", linewidth=2, label="常態分配曲線")
axes[0].axvline(USL, color="#e34948", linestyle="--", label=f"USL={USL}")
axes[0].axvline(LSL, color="#e34948", linestyle="--", label=f"LSL={LSL}")
axes[0].axvline(mean, color="#1baf7a", linewidth=1.2, label=f"平均={mean:.4f}")
axes[0].set_xlabel("量測值")
axes[0].set_ylabel("次數")
axes[0].set_title("直方圖與常態分配曲線")
axes[0].legend(fontsize=8)

# 常態機率圖
axes[1].scatter(z_scores, sorted_data, color="#2a78d6")
z_line = np.array([-2.5, 2.5])
axes[1].plot(z_line, mean + std * z_line, color="#e34948", linestyle="--", label="理論常態直線")
axes[1].set_xlabel("標準常態分位數 (z)")
axes[1].set_ylabel("量測值")
axes[1].set_title(f"常態機率圖 (Shapiro-Wilk p={sw_p:.3f})")
axes[1].legend(fontsize=8)

plt.tight_layout()
plt.savefig("process_capability_plots.png", dpi=150)
plt.show()
